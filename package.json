{
  "name": "ecommerce-v1",
  "version": "1.0.0",
  "description": "Hotel booking platform monorepo",
  "main": "index.js",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -p \"[{name}]\" -c \"cyan.bold,magenta.bold\" \"pnpm --filter api run start:dev\" \"pnpm --filter web run dev\"",
    "dev:api": "pnpm --filter api run start:dev",
    "dev:web": "pnpm --filter web run dev",
    "build": "pnpm --filter api run build && pnpm --filter web run build",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.6.0",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@12.6.0",
  "devDependencies": {
    "concurrently": "^10.0.5"
  }
}